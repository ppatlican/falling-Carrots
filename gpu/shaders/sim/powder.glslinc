// Behaviour class: POWDER. Frictional particle contacts.
// Mirror: cpu_ref/particle_step.gd _contact_delta. All indices are sorted indices.
// Any pair closer than `spacing` where at least one side is a powder is pushed apart,
// mass-weighted by material density (heavy sand sinks through water). Powders also get
// static/kinetic friction on their relative sideways motion this step. The sum is
// scaled by contact_relax. It is NOT averaged over the contact count: averaging let
// deep sand piles crush to ~8x rest density under water (Milestone 2 measurement).
// Between two powder grains the push-out is also mass-scaled by height (stack_weight):
// the upper grain gives way, so a pile is held up from the bottom instead of being
// crushed. Powder-liquid pairs don't use that: they use POWDER_LIQUID_SHARE, so water yields.
// Friction is cut for grains surrounded by liquid (wet_slip), see the end of contact_delta.

// Share of a powder-liquid contact's push-out that the powder takes (liquid takes the rest).
// Low, so water yields: water pushing into sand pushes the grains apart, they lose their
// contacts and flow. Mirror: SimParams.POWDER_LIQUID_SHARE.
const float POWDER_LIQUID_SHARE = 0.1;

// Share of a contact's push-out that particle t takes, for rv = p_t - p_j (y down).
float stack_weight(float m_t, float m_j, float rv_y) {
	return m_j / (m_t * exp(clamp(params.stack_k * rv_y, -8.0, 8.0)) + m_j);
}

vec2 contact_delta(uint t) {
	Material mt = materials[s_material(t)];
	bool t_powder = mt.info.x == CLASS_POWDER;
	vec2 pt = s_pred[t];
	vec2 move_t = pt - s_pos[t];
	vec2 sum = vec2(0.0);
	vec2 fric = vec2(0.0);
	float n_near = 0.0;
	float n_wet = 0.0;
	float fric_w = 0.0;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t) continue;
		Material mj = materials[s_material(j)];
		if (!t_powder && mj.info.x != CLASS_POWDER) continue;  // liquid-liquid: density constraint
		vec2 rv = pt - s_pred[j];
		float dist = length(rv);
		if (dist < params.h) {
			n_near += 1.0;
			n_wet += mj.info.x == CLASS_LIQUID ? 1.0 : 0.0;
		}
		if (dist >= params.spacing) continue;

		vec2 normal = pair_dir(rv, dist, t, j);
		float pen = params.spacing - dist;
		bool mixed = t_powder != (mj.info.x == CLASS_POWDER);
		float w = mixed
				? (t_powder ? POWDER_LIQUID_SHARE : 1.0 - POWDER_LIQUID_SHARE)
				: mj.phys.x / (mt.phys.x + mj.phys.x);
		bool stack = t_powder && mj.info.x == CLASS_POWDER;
		sum += (stack ? stack_weight(mt.phys.x, mj.phys.x, rv.y) : w) * pen * normal;

		float mu = min(mt.phys.y, mj.phys.y);
		if (mu > 0.0) {
			vec2 rel = move_t - (s_pred[j] - s_pos[j]);
			vec2 tangent = rel - dot(rel, normal) * normal;
			float t_len = length(tangent);
			if (t_len < mu * pen) {
				fric -= w * tangent;  // static friction: cancel the slide
			} else if (t_len > 1e-6) {
				fric -= w * tangent * min(0.8 * mu * pen / t_len, 1.0);  // kinetic
			}
			fric_w += w;
		}
	} END_NEIGHBOURS
	// Friction is averaged over the contacts (divided by their total weight, at least 1),
	// so the correction per iteration stays below CONTACT_RELAX. An unnormalised sum
	// overshoots with many contacts and makes a settled pile wobble.
	fric /= max(fric_w, 1.0);
	// Wet grains slip: friction drops with the share of liquid neighbours, so sand
	// under water slumps and sinks instead of holding water pockets inside the pile.
	float wet = n_near > 0.0 ? n_wet / n_near : 0.0;
	return (sum + fric * (1.0 - params.wet_slip * wet)) * params.contact_relax;
}
