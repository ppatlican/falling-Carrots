// Behaviour class: POWDER. Frictional particle contacts.
// Mirror: cpu_ref/particle_step.gd _contact_delta. All indices are sorted indices.
// Any pair closer than `spacing` (POWDER_LIQUID_REACH spacings for a grain and a liquid)
// where at least one side is a powder or a body particle (ADR 0003) is pushed apart,
// mass-weighted by material density (heavy sand sinks through water). Powders also get
// static/kinetic friction on their relative sideways motion this step. The sum is
// scaled by contact_relax. It is NOT averaged over the contact count: averaging let
// deep sand piles crush to ~8x rest density under water (Milestone 2 measurement).
// Between two powder grains the push-out is also mass-scaled by height (stack_weight):
// the upper grain gives way, so a pile is held up from the bottom instead of being
// crushed. Powder-liquid pairs don't use that: they use POWDER_LIQUID_SHARE, so water yields.
// A liquid particle's push from what it touches is averaged, not summed: the density
// projection grid holds water up at a sand bed (hydro_solve.glsl), so the push only has to keep
// water off the grains. Summed, it threw water touching several grains out of the bed along
// the slope's normal, and a pool in a sand bowl kept an eddy over the slopes at 2 px/s,
// up to 19 (water_feel_probe bowl). Averaged before the grid held the bed, 12-15k of 27k
// water soaked into the sand, since the push was all that held water out of it.
// Friction is cut for grains surrounded by liquid (wet_slip), see the end of contact_delta.
// Body particles (cluster solids, ADR 0002) follow the powder rule against grains and against
// particles of other bodies. Same-body pairs are skipped (shape matching holds a body
// together, body_match.glsl), except in a soft body, where members further apart in the rest
// shape than the region radius collide (self_contact, ADR 0005). In a contact with a body, the lower side is heavier by STACK_K
// over the height between the body centroids (a grain counts at its own height), on the
// friction as well as the push-out: with mass-weighted friction a 3-box stack swayed for good
// (CPU reference, ADR 0002). Body-liquid pairs (ADR 0003) touch at a full spacing and share
// the push-out by density only (no STACK_K; no friction, as water has none). Bodies don't get
// wet: WET_SLIP is a powder rule. A particle that sits inside another body's outline is also
// pushed out to it (push_out): all of it for a particle in no body, a body member its contact
// share (body-body pairs, ADR 0003 item 11).

// Share of a powder-liquid contact's push-out that the powder takes (liquid takes the rest).
// Low, so water yields: water pushing into sand pushes the grains apart, they lose their
// contacts and flow. Mirror: SimParams.POWDER_LIQUID_SHARE.
const float POWDER_LIQUID_SHARE = 0.1;
// Contact distance between a grain and a liquid particle, in spacings. At 1 (as between
// grains) a water particle couldn't pass between two grains, so sand that sank through
// water jammed loose (0.6-0.9 of rest) around the water it carried down. Shorter, the
// water drains out as the grains settle, and liquid.glslinc's grain share sets how much
// stays (water_feel_probe sink, 10k sand into 40k water, grain share 0.42, no drag:
// water in the bed 9.6k at 1.0, 6.5k at 0.8, 3.3k at 0.6). It also lets water lie closer
// on a bed (the dark strip in STATUS). Grains also fall through water more freely, which
// POWDER_LIQUID_DRAG makes up for. Mirror: SimParams.POWDER_LIQUID_REACH.
const float POWDER_LIQUID_REACH = 0.6;

// Share of a contact's push-out that particle t takes, for rv = p_t - p_j (y down).
float stack_weight(float m_t, float m_j, float rv_y) {
	return m_j / (m_t * exp(clamp(params.stack_k * rv_y, -8.0, 8.0)) + m_j);
}

// Push-out from inside a body (ADR 0003 items 8 and 11). x is a particle, j (sorted) its
// nearest particle of another body and body j's body. j's way out of the rest shape (rest_offset.zw),
// turned by j's rotation (member_rot: its body's from the last body pass, or in a soft body its
// region's, ADR 0005), gives the outward normal N and the
// outline's distance along it; x is inside by d = |e| - N.(x - x_j), and if so is moved d
// along N, to the outline. Nothing for a body whose outline is stale (part of it erased).
// A grain or water particle pushed into a lattice square sits at 0.7 spacing from four body
// particles whose contact push-outs cancel, so without this it stayed inside: an 8x6 box
// dropped 72 px onto sand ended with 7 grains inside (CPU reference; on the GPU from 100 px,
// 16). Mirror: ParticleStep._push_out.
vec2 push_out(vec2 x, uint j, uint body) {
	if ((bodies[body].info.w & BODY_STALE) != 0u) {
		return vec2(0.0);
	}
	vec2 e_rest = rest_offset[sorted_ids[j]].zw;
	vec2 r = member_rot(j, body);
	vec2 e = vec2(r.x * e_rest.x - r.y * e_rest.y, r.y * e_rest.x + r.x * e_rest.y);
	float len = length(e);
	if (len < 1e-6) {
		return vec2(0.0);
	}
	vec2 normal = e / len;
	float d = len - dot(normal, x - s_pred[j]);
	return d > 0.0 ? d * normal : vec2(0.0);
}

// stack_weight for a contact with a body (ADR 0002 item 11), except where either side is in a
// soft body (ADR 0005): there the share is by density alone, so a carrot set on a jelly presses
// it flat. With STACK_K the jelly under it, 20 px lower, acted e^6 times heavier and took almost
// none of the contact: it stood as tall as an unloaded one (body_probe squash).
// Mirror: ParticleStep.body_stack_weight.
float body_stack_weight(float m_t, float m_j, float dy, bool soft) {
	return soft ? m_j / (m_t + m_j) : stack_weight(m_t, m_j, dy);
}

// Same-body pair t, j (sorted) that collides (ADR 0005 item 4): in a soft body, members further
// apart in the rest shape than the region radius, so a floppy body folded onto itself lies on
// itself instead of passing through. Pairs within it are held by their regions, and a rigid
// body's by its shape. Mirror: ParticleStep._self_contact.
bool self_contact(uint t, uint j) {
	uint m = s_material(t);
	if (!soft_material(m)) {
		return false;
	}
	vec2 d = rest_offset[sorted_ids[t]].xy - rest_offset[sorted_ids[j]].xy;
	float reach = region_reach(m);
	return dot(d, d) > reach * reach;
}

// Height used for STACK_K in a contact with a body: the body's centroid from the last body
// pass, or the particle's own height when it is in no body.
float stack_height(uint t, uint body) {
	return body != 0u ? bodies[body].frame.y : s_pred[t].y;
}

// body_out: the part of the result that pushes a body member away from another body (contacts
// and push-out, ADR 0003 item 11), for velocity_update, which lets it stop the body but not
// send it away; 0 for anything else.
vec2 contact_delta(uint t, out vec2 body_out) {
	Material mt = materials[s_material(t)];
	bool t_powder = mt.info.x == CLASS_POWDER;
	bool t_liquid = mt.info.x == CLASS_LIQUID;
	uint t_body = s_body(t);
	bool t_soft = t_body != 0u && soft_material(s_material(t));
	float t_height = stack_height(t, t_body);
	vec2 pt = s_pred[t];
	vec2 move_t = pt - s_pos[t];
	vec2 sum = vec2(0.0);
	vec2 nearest_push = vec2(0.0);  // the nearest pair's contact push-out
	vec2 sum_bodies = vec2(0.0);  // body member t: the part of sum from other bodies
	vec2 fric = vec2(0.0);
	float n_near = 0.0;
	float n_wet = 0.0;
	float fric_w = 0.0;
	float n_touch = 0.0;
	uint nearest = 0xFFFFFFFFu;  // nearest particle of another body within a spacing
	uint nearest_body = 0u;
	float nearest_d = params.spacing;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t) continue;
		uint flags_j = s_mat[j];  // one read for the material and the body id
		Material mj = materials[flags_j & MAT_MASK];
		bool j_powder = mj.info.x == CLASS_POWDER;
		bool j_liquid = mj.info.x == CLASS_LIQUID;
		uint j_body = flags_j >> BODY_SHIFT;
		if (!t_powder && !j_powder && t_body == 0u && j_body == 0u) continue;  // liquid-liquid: the density constraint
		bool own = t_body != 0u && t_body == j_body;
		if (own && !self_contact(t, j)) continue;  // same body: shape matching
		vec2 rv = pt - s_pred[j];
		float dist = length(rv);
		if (dist < params.h) {
			n_near += 1.0;
			n_wet += j_liquid ? 1.0 : 0.0;
		}
		if (j_body != 0u && !own && dist < nearest_d) {
			nearest = j;
			nearest_body = j_body;
			nearest_d = dist;
		}
		bool powder_liquid = (t_liquid && j_powder) || (j_liquid && t_powder);
		float reach = powder_liquid ? POWDER_LIQUID_REACH * params.spacing : params.spacing;
		if (dist >= reach) continue;
		n_touch += 1.0;

		vec2 normal = pair_dir(rv, dist, t, j);
		float pen = reach - dist;
		float w = powder_liquid
				? (t_powder ? POWDER_LIQUID_SHARE : 1.0 - POWDER_LIQUID_SHARE)
				: mj.phys.x / (mt.phys.x + mj.phys.x);
		float w_push = w;
		if (t_powder && j_powder) {
			w_push = stack_weight(mt.phys.x, mj.phys.x, rv.y);
		} else if (!t_liquid && !j_liquid) {
			// A body, or a grain against one: friction takes the push-out's share (see top). Not
			// in a contact with a soft body: a load must reach it to squash it (body_stack_weight).
			w_push = body_stack_weight(mt.phys.x, mj.phys.x, t_height - stack_height(j, j_body),
					t_soft || (j_body != 0u && soft_material(flags_j & MAT_MASK)));
			w = w_push;
		}
		sum += w_push * pen * normal;
		if (t_body != 0u && j_body != 0u && !own) {
			sum_bodies += w_push * pen * normal;
		}
		if (j == nearest) {
			nearest_push = w_push * pen * normal;
		}

		float mu = min(mt.phys.y, mj.phys.y);
		if (mu > 0.0) {
			vec2 rel = move_t - (s_pred[j] - s_pos[j]);
			vec2 tangent = rel - dot(rel, normal) * normal;
			float t_len = length(tangent);
			if (t_len < mu * pen) {
				fric -= w * tangent;  // static friction: cancel the slide
			} else if (t_len > 1e-6) {
				fric -= w * tangent * min(0.8 * mu * pen / t_len, 1.0);  // kinetic
			}
			fric_w += w;
		}
	} END_NEIGHBOURS
	// Friction is averaged over the contacts (divided by their total weight, at least 1),
	// so the correction per iteration stays below CONTACT_RELAX. An unnormalised sum
	// overshoots with many contacts and makes a settled pile wobble.
	fric /= max(fric_w, 1.0);
	// Wet grains slip: friction drops with the share of liquid neighbours, so sand
	// under water slumps and sinks instead of holding water pockets inside the pile.
	// Bodies don't get wet (ADR 0003).
	float wet = t_powder && n_near > 0.0 ? n_wet / n_near : 0.0;
	if (t_liquid) {
		sum /= max(n_touch, 1.0);  // liquid: averaged over what it touches (see top)
	}
	vec2 out_push = vec2(0.0);
	body_out = vec2(0.0);
	if (nearest != 0xFFFFFFFFu) {
		out_push = push_out(pt, nearest, nearest_body);
		if (t_body != 0u && dot(out_push, pt - s_pred[nearest]) < 0.0) {
			// A member that has passed the nearest member's edge row (it lies on the inner side
			// of it along the outline's normal) is pushed on inward by that pair's contact, so
			// the outline decides instead (4 substeps, boxdrop: the rows locked 0.27 px apart,
			// the pair push 1.73 px in against the outline's 1.27 out). Only then: at an offset
			// stack's corner, dropping the pair whenever the push-out acted tilted the stack
			// (stack3 0.044 rad).
			sum -= nearest_push;
			sum_bodies -= nearest_push;
		}
		if (t_body != 0u) {
			// Body-body (ADR 0003 item 11): each side is pushed out of the other's outline by its
			// share of the contact, so the pair separates by the depth. Without it a carrot dropped
			// 150 px onto another (~240 px/s, over a spacing per substep) ended inside it, the
			// ordinary contacts balanced among the interleaved lattices (body_probe boxdrop).
			out_push *= body_stack_weight(mt.phys.x, materials[s_material(nearest)].phys.x,
					t_height - stack_height(nearest, nearest_body), t_soft || soft_material(s_material(nearest)));
			body_out = (sum_bodies + out_push) * params.contact_relax;
		}
	}
	return (sum + fric * (1.0 - params.wet_slip * wet) + out_push) * params.contact_relax;
}

// Drag of a grain toward the liquid around it, per px/s of their relative speed and per
// second (quadratic drag, as on a sinking grain at speed). A grain sinking through water
// at v slows at POWDER_LIQUID_DRAG * v^2, so it falls at ~sqrt(g / POWDER_LIQUID_DRAG)
// (~80 px/s), while a resting bed that drains at a few px/s barely feels it. Without it,
// POWDER_LIQUID_REACH let sand fall through a pool nearly as through air, in stripes
// (main.tscn, 10k sand into 30k water: on the floor ~100 frames after the drop). A linear
// drag of 6 or 12 per second stopped that too, but slowed the drainage: 5.3k water left in
// the sunk bed instead of 3.3k (water_feel_probe sink). Mirror: SimParams.POWDER_LIQUID_DRAG.
const float POWDER_LIQUID_DRAG = 0.06;

// Linear drag of a body particle toward the liquid around it, per second, scaled by how much
// liquid is around it (ADR 0003). Only wet particles feel it, so a body's drag grows with its
// wet surface while its mass grows with its area. Without it a floating cork heaved at its
// natural period (~0.8 s for an 8x6 box) and a cork rising from the floor capsized at the
// surface; at 40 it rolled over under water (CPU reference). Mirror: SimParams.BODY_LIQUID_DRAG.
const float BODY_LIQUID_DRAG = 20.0;

// Velocity change of body particle t from BODY_LIQUID_DRAG. Mirror: ParticleStep._body_liquid_drag.
vec2 body_liquid_drag(uint t) {
	vec2 pt = s_pred[t];
	vec2 vt = s_vel[t];
	vec2 sum = vec2(0.0);
	float w_sum = 0.0;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t || s_class(j) != CLASS_LIQUID) continue;
		vec2 rv = pt - s_pred[j];
		float w = poly6(dot(rv, rv));
		sum += (s_vel[j] - vt) * w;
		w_sum += w;
	} END_NEIGHBOURS
	if (w_sum <= 0.0) {
		return vec2(0.0);
	}
	return sum / w_sum * ((1.0 - exp(-BODY_LIQUID_DRAG * params.dt)) * min(w_sum / params.rest_density, 1.0));
}

// Velocity change of grain t from POWDER_LIQUID_DRAG: toward its liquid neighbours'
// kernel-weighted velocity, scaled by how much liquid is around it (1 in water at rest
// density, less at a bed or a surface).
vec2 powder_liquid_drag(uint t) {
	vec2 pt = s_pred[t];
	vec2 vt = s_vel[t];
	vec2 sum = vec2(0.0);
	float w_sum = 0.0;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t || s_class(j) != CLASS_LIQUID) continue;
		vec2 rv = pt - s_pred[j];
		float w = poly6(dot(rv, rv));
		sum += (s_vel[j] - vt) * w;
		w_sum += w;
	} END_NEIGHBOURS
	if (w_sum <= 0.0) {
		return vec2(0.0);
	}
	vec2 rel = sum / w_sum;  // liquid's mean velocity relative to the grain
	float rate = POWDER_LIQUID_DRAG * length(rel);
	return rel * ((1.0 - exp(-rate * params.dt)) * min(w_sum / params.rest_density, 1.0));
}
