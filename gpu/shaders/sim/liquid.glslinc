// Behaviour class: LIQUID. PBF density constraint (Macklin & Mueller 2013).
// Mirror: cpu_ref/particle_step.gd _lambda / _liquid_delta / _xsph.
// All indices are sorted indices (see common.glslinc).
// Density is normalised (1.0 = rest). Every neighbour adds to density, so liquids
// are pushed out of powder too, but only liquid neighbours move with the constraint.
// The constraint only pushes apart (C >= 0), which keeps free surfaces stable.
// Walls count toward density (wall_density), and liquid-liquid pushes are mass-scaled
// by height like powder stacks (stack_k), see liquid_delta.

// Anti-clumping / surface-tension term (n = 4, dq = 0.2 h).
float scorr(float r2) {
	float w = poly6(r2) / poly6(0.04 * params.h * params.h);
	return -params.scorr_k * w * w * w * w;
}

// Density a wall at distance d adds: poly6 integrated over the half-plane past the
// wall, filled at rest density. slope = d(density)/dd (negative: less further away).
float wall_density_1d(float d, out float slope) {
	if (d >= params.h) {
		slope = 0.0;
		return 0.0;
	}
	float s = max(d, 0.0) / params.h;
	float a = asin(s);
	float q = 1.0 - s * s;
	float c = 128.0 / (35.0 * PI);
	slope = -params.rest_density * c / params.h * q * q * q * sqrt(q);
	float j = (35.0 * a + 28.0 * sin(2.0 * a) + 7.0 * sin(4.0 * a) + 4.0 / 3.0 * sin(6.0 * a)
			+ 0.125 * sin(8.0 * a)) / 128.0;
	return params.rest_density * (0.5 - c * j);
}

// Density from all four walls, and its gradient with respect to p. Without it a liquid
// particle at a wall misses half its neighbours, so the liquid crowded into the walls
// and the squeezed wall particles were lifted up the wall in jets of 300+ px/s
// (Milestone 2 GPU measurement). Mirror: ParticleStep.wall_density.
float wall_density(vec2 p, out vec2 grad) {
	float sl;
	float sr;
	float st;
	float sb;
	float density = wall_density_1d(p.x, sl) + wall_density_1d(params.world_size.x - p.x, sr)
			+ wall_density_1d(p.y, st) + wall_density_1d(params.world_size.y - p.y, sb);
	grad = vec2(sl - sr, st - sb);
	return density;
}

float liquid_lambda(uint t) {
	vec2 pt = s_pred[t];
	vec2 wall_grad;
	float density = poly6(0.0) + wall_density(pt, wall_grad);
	vec2 grad_t = wall_grad / params.rest_density;
	float grad_sum = 0.0;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t) continue;
		vec2 rv = pt - s_pred[j];
		float r2 = dot(rv, rv);
		if (r2 >= params.h * params.h) continue;
		density += poly6(r2);
		vec2 g = spiky_grad(rv, t, j) / params.rest_density;
		grad_t += g;
		if (s_class(j) == CLASS_LIQUID) {
			grad_sum += dot(g, g);
		}
	} END_NEIGHBOURS
	float c = max(density / params.rest_density - 1.0, 0.0);
	return -c / (grad_sum + dot(grad_t, grad_t) + params.lambda_eps);
}

// Between two liquid particles the push is mass-scaled by height, as for powder stacks
// (stack_weight in powder.glslinc, equal masses): the upper particle takes the larger
// share. Plain PBF needs a pressure that grows with depth to hold a column up with a
// few Jacobi iterations; at 50k the bottom was squeezed to ~3x rest density and every
// particle jittered at ~100 px/s. With the scaling a small, even pressure holds it.
// Like the powder version it is not momentum-conserving: a squeezed pair's centre moves
// up a little. That is the support, but it also drives some convection in deep water
// (see docs/STATUS.md Known issues).
vec2 liquid_delta(uint t) {
	vec2 pt = s_pred[t];
	float lt = lambda[t];
	vec2 wall_grad;
	wall_density(pt, wall_grad);
	vec2 d = lt * wall_grad;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t) continue;
		vec2 rv = pt - s_pred[j];
		float r2 = dot(rv, rv);
		if (r2 >= params.h * params.h) continue;
		bool liquid_j = s_class(j) == CLASS_LIQUID;
		float lj = liquid_j ? lambda[j] : 0.0;
		float share = liquid_j ? 2.0 / (exp(clamp(params.stack_k * rv.y, -8.0, 8.0)) + 1.0) : 1.0;
		d += share * (lt + lj + scorr(r2)) * spiky_grad(rv, t, j);
	} END_NEIGHBOURS
	return d / params.rest_density;
}

// XSPH viscosity: blend toward liquid neighbours' velocity. Material viscosity is the blend.
vec2 liquid_xsph(uint t) {
	vec2 pt = s_pred[t];
	vec2 vt = s_vel[t];
	vec2 sum = vec2(0.0);
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t || s_class(j) != CLASS_LIQUID) continue;
		vec2 rv = pt - s_pred[j];
		sum += (s_vel[j] - vt) * poly6(dot(rv, rv));
	} END_NEIGHBOURS
	return sum * (materials[s_material(t)].phys.z / params.rest_density);
}
