// Stickiness (ADR 0011): cohesion and adhesion, applied as speed in velocity_xsph.glsl
// (stick_velocity), only while params.sticky is set (some material has any). Include after
// common.glslinc and powder.glslinc. All indices are sorted indices. Mirror:
// cpu_ref/particle_step.gd, the Stickiness section (_stick_pull, _stick_damp, _stick_drag and their
// helpers); the constants are SimParams'.
//
// A sticky pair pulls together by STICK_G x gravity x its coefficient (stick_k), as its contact
// pushes it apart (contact_share), over a short band past touching (stick_shape), and loses its
// speed apart up to the same limit. The pull is speed added at the end of the step, as gravity is
// in predict, so a grain hung by it doesn't move; the solver still keeps everything apart. A wall
// pulls a particle near it by its adhesion. A pair's pull is capped, and so is a particle's sum
// (STICK_CAP), so a sticky clump breaks under enough weight.

const float STICK_G = 4.0;
const float STICK_FULL = 0.15;
const float STICK_REACH = 0.4;
const float STICK_WALL = 0.75;
const float STICK_CAP = 6.0;
const float STICK_DRAG = 30.0;

// Stickiness coefficient of a pair of materials: cohesion within one material, else the larger
// adhesion (honey sticks to a carrot whatever the carrot's). A mochi material's cohesion is its pair
// pull instead (mochi_push, ADR 0017). Mirror: ParticleStep._stick_k.
float stick_k(uint m_t, uint m_j) {
	if (m_t == m_j) {
		return materials[m_t].info.x != CLASS_MOCHI ? materials[m_t].more.y : 0.0;
	}
	return max(materials[m_t].more.z, materials[m_j].more.z);
}

// Strength of a pull between two particles x px further apart than touching: 0 when they touch or
// overlap, full at STICK_FULL spacings, 0 from STICK_REACH, so it only resists pulling apart. A pull
// while touching presses the pair, and its contact pushes it apart again mostly upward (STACK_K):
// a sticky block fell at a quarter of a dry one's speed. stick_damp catches a row hung under
// another before it sags far enough for this to hold it. Mirror: ParticleStep.stick_shape.
float stick_shape(float x) {
	float full = STICK_FULL * params.spacing;
	float reach = STICK_REACH * params.spacing;
	if (x <= 0.0 || x >= reach) {
		return 0.0;
	}
	return x < full ? x / full : (reach - x) / (reach - full);
}

// Strength of a hold at x px past touching: full out to STICK_FULL spacings, 0 from STICK_REACH.
// A wall's pull (x past STICK_WALL spacings from it; the clamp keeps a particle at 0.5-0.75) and a
// liquid's drag along what it sticks to. Mirror: ParticleStep.stick_hold.
float stick_hold(float x) {
	float full = STICK_FULL * params.spacing;
	float reach = STICK_REACH * params.spacing;
	return clamp((reach - x) / (reach - full), 0.0, 1.0);
}

// Contact distance of the pair t, j (sorted; contact_delta's reach). Mirror: ParticleStep._touch_distance.
float touch_distance(uint t, uint j) {
	uint c_t = s_class(t);
	uint c_j = s_class(j);
	if ((c_t == CLASS_POWDER && c_j == CLASS_LIQUID) || (c_t == CLASS_LIQUID && c_j == CLASS_POWDER)) {
		return POWDER_LIQUID_REACH * params.spacing;
	}
	bool soft_t = s_body(t) != 0u && soft_material(s_material(t));
	bool soft_j = s_body(j) != 0u && soft_material(s_material(j));
	if ((soft_t && c_j == CLASS_POWDER) || (c_t == CLASS_POWDER && soft_j)) {
		return SOFT_GRAIN_REACH * params.spacing;
	}
	return params.spacing;
}

// Share of a pair's push-out t takes in contact_delta (w_push there). The pull and the damping are
// split the same way, so a pull that ends in a contact is undone as it was made: split by mass
// while the pull still acted on touching pairs, a pair one above the other was pulled together
// evenly and pushed apart mostly upward (STACK_K), and a sticky clump in mid-air rose to the ceiling.
// Mirror: ParticleStep._contact_share.
float contact_share(uint t, uint j) {
	Material mt = materials[s_material(t)];
	Material mj = materials[s_material(j)];
	uint ct = mt.info.x;
	uint cj = mj.info.x;
	if ((ct == CLASS_POWDER && cj == CLASS_LIQUID) || (ct == CLASS_LIQUID && cj == CLASS_POWDER)) {
		return ct == CLASS_POWDER ? POWDER_LIQUID_SHARE : 1.0 - POWDER_LIQUID_SHARE;
	}
	if (ct == CLASS_POWDER && cj == CLASS_POWDER) {
		return stack_weight(mt.phys.x, mj.phys.x, s_pred[t].y - s_pred[j].y);
	}
	uint bt = s_body(t);
	uint bj = s_body(j);
	if (ct != CLASS_LIQUID && cj != CLASS_LIQUID && !((ct == CLASS_MOCHI || cj == CLASS_MOCHI) && bt == 0u && bj == 0u)) {
		return body_stack_weight(mt.phys.x, mj.phys.x, stack_height(t, bt) - stack_height(j, bj),
				bt != 0u && soft_material(s_material(t)), bj != 0u && soft_material(s_material(j)));
	}
	return mj.phys.x / (mt.phys.x + mj.phys.x);
}

// Velocity change of t from stickiness in one step, in one neighbour loop (three loops cost
// ~+110-140 us a frame at 50k; mirrored by three CPU functions):
// - the pull (ParticleStep._stick_pull): each sticky neighbour not of its own body (its shape holds
//   that) pulls it by STICK_G x gravity x stick_k x stick_shape x contact_share; each wall within
//   reach pulls it by its adhesion in full; at most STICK_CAP x gravity;
// - the damping (ParticleStep._stick_damp): a sticky pair touching or within the band (stick_hold)
//   that is moving apart loses that speed, up to what its pull could take away in a step
//   (STICK_G x gravity x stick_k x dt), shared as its contact. It never presses a pair, so it lifts
//   nothing, and it catches a row hung under another before it sags out of the pull's reach;
// - the slip (ParticleStep._stick_drag): a wall's pull never reaches solve_apply's wall friction
//   (predict clamps the particle to the wall first), so a grain or body particle a wall pulls gets
//   Coulomb friction here, up to its friction x the pull, against its speed along the wall and the
//   gravity the next step adds along it. A liquid has no friction: it is dragged toward the velocity
//   of what it sticks to that isn't liquid (a wall's is 0, and only along the wall) at STICK_DRAG
//   per second x stick_k x stick_hold, averaged over at least a weight of 1, so it creeps instead
//   of sliding off (honey on a wall).
vec2 stick_velocity(uint t) {
	uint m_t = s_material(t);
	Material mt = materials[m_t];
	uint c_t = mt.info.x;
	bool t_liquid = c_t == CLASS_LIQUID;
	uint b_t = s_body(t);
	vec2 pt = s_pred[t];
	vec2 vt = s_vel[t];
	float g = params.gravity;
	vec2 a = vec2(0.0);  // pull, in units of STICK_G x gravity
	vec2 damp = vec2(0.0);
	vec2 drag = vec2(0.0);  // liquid: sum of weighted relative velocities
	float drag_w = 0.0;
	FOR_EACH_NEIGHBOUR(t) {
		uint j = k;
		if (j == t || (b_t != 0u && s_body(j) == b_t)) continue;
		uint m_j = s_material(j);
		float kj = stick_k(m_t, m_j);
		if (kj <= 0.0) continue;
		uint c_j = materials[m_j].info.x;
		vec2 rv = s_pred[j] - pt;
		float r = length(rv);
		if (r < MIN_DIST) continue;
		float x = r - touch_distance(t, j);
		float hold = stick_hold(x);
		if (hold <= 0.0) continue;  // stick_shape is 0 there too
		vec2 n = rv / r;
		vec2 dv = s_vel[j] - vt;
		float share = contact_share(t, j);
		a += n * (kj * stick_shape(x) * share);
		float sep = dot(dv, n);  // > 0: moving apart
		if (sep > 0.0) {
			damp += n * (min(sep, kj * hold * STICK_G * g * params.dt) * share);
		}
		if (t_liquid && c_j != CLASS_LIQUID) {
			drag += dv * (kj * hold);
			drag_w += kj * hold;
		}
	} END_NEIGHBOURS
	float adh = mt.more.z;
	float wall = STICK_WALL * params.spacing;
	float wx = stick_hold(pt.x - wall) + stick_hold(params.world_size.x - pt.x - wall);  // side walls
	float wy = stick_hold(pt.y - wall) + stick_hold(params.world_size.y - pt.y - wall);  // floor, ceiling
	vec2 slip = vec2(0.0);
	if (adh > 0.0) {
		a += vec2(-stick_hold(pt.x - wall) + stick_hold(params.world_size.x - pt.x - wall),
				-stick_hold(pt.y - wall) + stick_hold(params.world_size.y - pt.y - wall)) * adh;
		if (t_liquid) {
			drag += vec2(-vt.x * wy, -vt.y * wx) * adh;
			drag_w += (wx + wy) * adh;
		} else {
			float limit = mt.phys.y * adh * STICK_G * g * params.dt;
			vec2 need = vec2(vt.x, vt.y + g * params.dt);  // what the next step slides by
			slip = vec2(-clamp(need.x, -limit * wy, limit * wy), -clamp(need.y, -limit * wx, limit * wx));
		}
	}
	if (drag_w > 0.0) {
		slip += drag / max(drag_w, 1.0) * (1.0 - exp(-STICK_DRAG * params.dt));
	}
	a *= STICK_G * g;
	float len = length(a);
	float cap = STICK_CAP * g;
	if (len > cap) {
		a *= cap / len;
	}
	return a * params.dt + damp + slip;
}
