// Liquid density projection on a coarse grid. Included after common.glslinc.
// Mirror: cpu_ref/particle_step.gd _hydro_*.
//
// PBF with a few Jacobi iterations can't build a pressure that grows with depth: each
// iteration reaches about one kernel radius, and deep water was ~75 radii deep. Without
// help 50k water squeezed to 2.5x rest density at the floor. Earlier fixes faked the
// missing pressure locally (stack scaling, a per-particle carried-over pressure), and
// both churned: the stack scaling lifts each squeezed pair, so water held slopes like a
// sand pile and boiled at the surface, and a per-particle pressure strong enough to hold
// the floor sloshed (GPU probe, 2026-10-10).
//
// Instead a coarse grid solves, once per frame before the PBF iterations, for a pressure
// p >= 0 whose push (-grad p dt^2, hydro_delta) removes HYDRO_K of each cell's
// compression (Kugelstadt et al. 2019, "Implicit Density Projection for Volume Conserving
// Liquids"): div(grad p) = -HYDRO_K (phi - 1) / dt^2, with phi the liquid density of the
// cell over rest, where phi > 1, or anywhere under full water (an air bubble). The solve spans the whole grid, so the floor's
// compression lifts the whole column in one step, and PBF only fixes local spacing.
// Gravity is applied as usual: p comes only from compression, so water that lifts off
// the floor falls back. (A pressure built from the weight of the liquid above made the
// water weightless as a body: it bounced to the ceiling.)
//
// Air cells (phi < HYDRO_AIR) are outside the liquid and the walls let nothing through.
// Cells mostly full of powder (hydro_solid) are sand bed: a wall that holds the water's
// weight (dp/dn = rho g . n), with the pressure continued hydrostatically into the pores
// (the bed as a porous solid, Tampubolon et al. 2017). A bed's pore water is too thin to
// count as liquid, so the bed used to be air: p fell to 0 at the sand surface, the grid
// pushed water into the bed, the contact push threw it back out along the slope's normal,
// and a pool in a sand bowl circulated at ~6 px/s (water_feel_probe bowl, 2026-10-11).
// The free surface is a ghost-fluid boundary (Gibou et al. 2002; Enright et al. 2003):
// p = 0 sits where phi crosses HYDRO_SURFACE between a liquid cell and its air
// neighbour, a share theta of the way, not at the air cell's centre. With p = 0 at the
// air centre the push that holds water against gravity reached ~8 px past the surface
// and held loose drops hovering there. Air cells store the ghost pressure (p of the
// liquid side extrapolated through 0 at the surface, so negative), the bilinear sample
// is 0 at the surface, and a sample is clamped to >= 0, so nothing pushes above it. Coarse cells
// are HYDRO_CELL hash cells across (16 px), and phi is tent-weighted, so a particle
// crossing a cell edge doesn't make p jump. The solve is projected red-black SOR (p kept
// >= 0), warm-started from the last frame's p (kept in hydro_p).

// Bodies (ADR 0003): body particles fill a cell as water at rest does. Their volume counts
// toward a cell being bed (hydro_solid), full (the bubble pull) and compressed; for the air
// test and the free surface a cell's level counts them at their weight in water
// (hydro_level), since a floating body displaces its own weight of water. The grid pushes
// only liquid; a body is pushed by the pressure on its wet surface (body_p_sample,
// solve_pressure.glsl).

// Per coarse cell, over rest density: x liquid, y powder, z body volume, w body weight in
// water (each body particle at min(density, 1)).
layout(set = 0, binding = 20, std430) buffer HydroPhi { vec4 hydro_phi[]; };
layout(set = 0, binding = 21, std430) buffer HydroP { float hydro_p[]; };      // pressure per coarse cell
// Tent-weighted particle sums per coarse cell, times HYDRO_FP: [4c + k] for the channels of
// hydro_phi. hydro_splat adds, hydro_phi reads and zeroes for the next frame.
layout(set = 0, binding = 22, std430) buffer HydroAcc { int hydro_acc[]; };

const float HYDRO_FP = 1024.0;

// Hash cells per coarse cell along each axis. Mirror: SimParams.HYDRO_CELL.
const int HYDRO_CELL = 4;
// Density below which a coarse cell is air (p = 0). Mirror: SimParams.HYDRO_AIR.
const float HYDRO_AIR = 0.3;
// Liquid density over rest at the free surface, and the smallest share of a cell the
// surface may sit from a liquid cell's centre (keeps 1/theta bounded when the surface
// is near the centre). A stiffer clamp of 0.5 was worse: the pool's top layer moved at
// 2-6 px/s, up to 30, and drops hovered again; 0.1 left it at ~0.1 px/s (GPU probe). Mirror: SimParams.HYDRO_SURFACE, HYDRO_THETA_MIN.
const float HYDRO_SURFACE = 0.5;
const float HYDRO_THETA_MIN = 0.1;
// Red-black SOR sweeps per step (hydro_solve.glsl), warm-started from the last step's p.
// Fewer don't converge in deep water: 16 left 50k water moving at 6.5 px/s with a 12 px
// tilt. Mirror: SimParams.HYDRO_SWEEPS.
const int HYDRO_SWEEPS = 32;
// Most coarse cells hydro_solve.glsl holds in shared memory (the 640x360 world at 16 px
// cells is 40 x 23 = 920). particle_sim.gd refuses to start on a bigger grid.
// Mirror: ParticleSim.HYDRO_MAX_CELLS.
const int HYDRO_MAX_CELLS = 1024;
// SOR over-relaxation. Mirror: SimParams.HYDRO_SOR.
const float HYDRO_SOR = 1.8;
// Share of a cell's compression removed per 1/60 s; hydro_k() gives the share per step, so
// substeps don't stiffen the grid. Mirror: SimParams.HYDRO_K.
const float HYDRO_K = 0.5;

float hydro_k() {
	return 1.0 - pow(1.0 - HYDRO_K, params.dt * 60.0);
}
// Density over rest from which the cell above counts as full (see hydro_relax in hydro_solve.glsl).
// Mirror: SimParams.HYDRO_FULL.
const float HYDRO_FULL = 0.95;
// Share of a cell one unit of powder density fills: sand packs to about 1.4x the
// water's rest density, so 1 / 1.4. Mirror: SimParams.HYDRO_POWDER_VOL.
const float HYDRO_POWDER_VOL = 0.7;
// Share of a cell one unit of powder density fills when checking a cell for room left
// (the bubble pull in hydro_relax, hydro_solve.glsl): sand under water packs to only ~1.1 (bed cells read
// 1.07-1.17), and water can't get into its pores, so a cell of such sand is full. At 0.7 a
// cell half sand and half water read ~0.97 full, and the pull, ~3-4 cells of hydrostatic
// head per 1% of room, sucked water into every sand surface cell: p at the peaks of
// mounds under a pool fell 0.7-2.5 head under hydrostatic, and the water circulated over
// them at up to 17 px/s (water_feel_probe mounds, 2026-10-11). Mirror: SimParams.HYDRO_POWDER_FULL.
const float HYDRO_POWDER_FULL = 0.9;

ivec2 hydro_size() {
	return ivec2((int(params.grid_w) + HYDRO_CELL - 1) / HYDRO_CELL,
			(int(params.grid_h) + HYDRO_CELL - 1) / HYDRO_CELL);
}

float hydro_cell_size() { return params.h * float(HYDRO_CELL); }

uint hydro_index(ivec2 c) { return uint(c.y * hydro_size().x + c.x); }

// Share of a 1D tent of half-width a, centred at c, that lies inside [0, w].
float hydro_tent_inside(float c, float a, float w) {
	float lo = max(1.0 - c / a, 0.0);
	float hi = max(1.0 - (w - c) / a, 0.0);
	return 1.0 - 0.5 * (lo * lo + hi * hi);
}

// Adds a particle at x, times `amount`, to one of the density sums (channels of hydro_phi):
// its tent weight (bilinear, half-width one cell) on the four nearest cell centres, in fixed
// point so it can use atomicAdd.
// Integer sums don't depend on the order of the adds, so the result is deterministic.
// (A gather per cell over the hash took ~900 us at 50k: 920 threads, each looping
// over ~300 particles.)
void hydro_splat(vec2 x, uint channel, float amount) {
	ivec2 size = hydro_size();
	vec2 g = x / hydro_cell_size() - 0.5;
	ivec2 b = ivec2(floor(g));
	vec2 f = g - vec2(b);
	for (int dy = 0; dy < 2; dy++) {
		for (int dx = 0; dx < 2; dx++) {
			ivec2 c = b + ivec2(dx, dy);
			if (c.x < 0 || c.y < 0 || c.x >= size.x || c.y >= size.y) {
				continue;
			}
			float w = (dx == 0 ? 1.0 - f.x : f.x) * (dy == 0 ? 1.0 - f.y : f.y);
			atomicAdd(hydro_acc[4u * hydro_index(c) + channel], int(round(w * amount * HYDRO_FP)));
		}
	}
}

// The channels of hydro_phi at coarse cell c from the splatted sums: the tent weight over
// the weight at rest spacing of the part of the tent inside the world (at the walls only
// part of it can be filled).
vec4 hydro_density(ivec2 ci) {
	float a = hydro_cell_size();
	vec2 centre = (vec2(ci) + 0.5) * a;
	uint i = hydro_index(ci);
	vec4 sum = vec4(float(hydro_acc[4u * i]), float(hydro_acc[4u * i + 1u]),
			float(hydro_acc[4u * i + 2u]), float(hydro_acc[4u * i + 3u])) / HYDRO_FP;
	float inside = hydro_tent_inside(centre.x, a, params.world_size.x)
			* hydro_tent_inside(centre.y, a, params.world_size.y);
	return sum * params.spacing * params.spacing / (a * a * inside);
}

// Share of the way from a liquid cell (phi_f) to its air neighbour (phi_a) at which
// phi crosses HYDRO_SURFACE, clamped to [HYDRO_THETA_MIN, 1].
float hydro_theta(float phi_f, float phi_a) {
	return clamp((phi_f - HYDRO_SURFACE) / max(phi_f - phi_a, 1e-4), HYDRO_THETA_MIN, 1.0);
}

// A cell this full of powder is part of the sand bed: a solid wall for the grid (see
// hydro_solve.glsl). Mirror: SimParams.HYDRO_SOLID.
const float HYDRO_SOLID = 0.5;

// Share of a cell taken by bed: powder at its packing, and body volume.
float hydro_solid_fill(vec4 phi) { return phi.y * HYDRO_POWDER_VOL + phi.z; }

bool hydro_solid(vec4 phi) { return hydro_solid_fill(phi) >= HYDRO_SOLID; }

// A cell's liquid level for the air test and the free surface: its liquid, plus its body
// particles at their weight in water, counted in full only where the cell has at least
// HYDRO_AIR of liquid (so a dry body's cells stay air). Counted by volume instead (or left
// out), a floating body raised (or lowered) the grid's surface where it sat, and the pressure
// on its sides pushed it away from (or after) wherever it went (CPU reference, ADR 0003).
// Mirror: ParticleStep.hydro_level.
float hydro_level(vec4 phi) { return phi.x + phi.w * min(phi.x / HYDRO_AIR, 1.0); }

// Pressure at coarse cell c (the ghost in air cells). Past the grid edge it is mirrored,
// so walls let nothing through. (Continuing p hydrostatically past the floor, to match
// hydro_relax, held the bottom layer up twice, with the walls' share of the PBF density:
// 50k water's bottom 20 px thinned to 0.97 of rest, GPU probe.)
float hydro_p_at(ivec2 c) {
	return hydro_p[hydro_index(clamp(c, ivec2(0), hydro_size() - ivec2(1)))];
}

// Bilinear pressure at position x (cell centres at (i + 0.5) * cell size), 0 past the
// free surface.
float hydro_p_sample(vec2 x) {
	vec2 g = x / hydro_cell_size() - 0.5;
	ivec2 b = ivec2(floor(g));
	vec2 f = g - vec2(b);
	float p00 = hydro_p_at(b);
	float p10 = hydro_p_at(b + ivec2(1, 0));
	float p01 = hydro_p_at(b + ivec2(0, 1));
	float p11 = hydro_p_at(b + ivec2(1, 1));
	return max(mix(mix(p00, p10, f.x), mix(p01, p11, f.x), f.y), 0.0);
}

// Share of the space at x taken by powder, bilinear over the coarse cells' powder
// density at its packing under water (HYDRO_POWDER_FULL), so a settled bed reads ~1 and
// open water 0. The draw uses it to tell pore liquid from open liquid (render_points).
float hydro_powder_fill(vec2 x) {
	ivec2 size = hydro_size();
	vec2 g = x / hydro_cell_size() - 0.5;
	ivec2 b = ivec2(floor(g));
	vec2 f = g - vec2(b);
	float v[4];
	for (int k = 0; k < 4; k++) {
		ivec2 c = clamp(b + ivec2(k & 1, k >> 1), ivec2(0), size - ivec2(1));
		v[k] = hydro_phi[hydro_index(c)].y;
	}
	return mix(mix(v[0], v[1], f.x), mix(v[2], v[3], f.x), f.y) * HYDRO_POWDER_FULL;
}

// Position change this step from the pressure: -grad p * dt^2 (central difference over
// half a coarse cell).
vec2 hydro_delta(vec2 x) {
	float e = 0.5 * hydro_cell_size();
	vec2 grad = vec2(hydro_p_sample(x + vec2(e, 0.0)) - hydro_p_sample(x - vec2(e, 0.0)),
			hydro_p_sample(x + vec2(0.0, e)) - hydro_p_sample(x - vec2(0.0, e))) / (2.0 * e);
	return -grad * params.dt * params.dt;
}

// Grid pressure at x for a body's surface: the bilinear sample, continued hydrostatically
// below the last row of cell centres, where the sample alone stops growing.
// Mirror: ParticleStep._body_p_sample.
float body_p_sample(vec2 x) {
	float y_last = (float(hydro_size().y) - 0.5) * hydro_cell_size();
	float s = hydro_p_sample(vec2(x.x, min(x.y, y_last)));
	return s > 0.0 ? s + params.gravity * max(x.y - y_last, 0.0) : 0.0;
}
