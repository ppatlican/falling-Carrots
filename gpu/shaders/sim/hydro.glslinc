// Liquid density projection on a coarse grid. Included after common.glslinc.
// Mirror: cpu_ref/particle_step.gd _hydro_*.
//
// PBF with a few Jacobi iterations can't build a pressure that grows with depth: each
// iteration reaches about one kernel radius, and deep water was ~75 radii deep. Without
// help 50k water squeezed to 2.5x rest density at the floor. Earlier fixes faked the
// missing pressure locally (stack scaling, a per-particle carried-over pressure), and
// both churned: the stack scaling lifts each squeezed pair, so water held slopes like a
// sand pile and boiled at the surface, and a per-particle pressure strong enough to hold
// the floor sloshed (GPU probe, 2026-10-10).
//
// Instead a coarse grid solves, once per frame before the PBF iterations, for a pressure
// p >= 0 whose push (-grad p dt^2, hydro_delta) removes HYDRO_K of each cell's
// compression (Kugelstadt et al. 2019, "Implicit Density Projection for Volume Conserving
// Liquids"): div(grad p) = -HYDRO_K (phi - 1) / dt^2, with phi the liquid density of the
// cell over rest, where phi > 1, or anywhere under full water (an air bubble). The solve spans the whole grid, so the floor's
// compression lifts the whole column in one step, and PBF only fixes local spacing.
// Gravity is applied as usual: p comes only from compression, so water that lifts off
// the floor falls back. (A pressure built from the weight of the liquid above made the
// water weightless as a body: it bounced to the ceiling.)
//
// Air cells (phi < HYDRO_AIR) hold p = 0 and the walls let nothing through. Coarse cells
// are HYDRO_CELL hash cells across (16 px), and phi is tent-weighted, so a particle
// crossing a cell edge doesn't make p jump. The solve is projected red-black SOR (p kept
// >= 0), warm-started from the last frame's p (kept in hydro_p).

// Per coarse cell: x liquid density over rest, y powder density over rest.
layout(set = 0, binding = 20, std430) buffer HydroPhi { vec2 hydro_phi[]; };
layout(set = 0, binding = 21, std430) buffer HydroP { float hydro_p[]; };      // pressure per coarse cell
// Tent-weighted particle sums per coarse cell, times HYDRO_FP: [2c] liquid, [2c + 1]
// powder. hydro_splat adds, hydro_phi reads and zeroes for the next frame.
layout(set = 0, binding = 22, std430) buffer HydroAcc { int hydro_acc[]; };

const float HYDRO_FP = 1024.0;

// Hash cells per coarse cell along each axis. Mirror: SimParams.HYDRO_CELL.
const int HYDRO_CELL = 4;
// Density below which a coarse cell is air (p = 0). Mirror: SimParams.HYDRO_AIR.
const float HYDRO_AIR = 0.3;
// SOR over-relaxation. Mirror: SimParams.HYDRO_SOR.
const float HYDRO_SOR = 1.8;
// Share of a cell's compression removed per 1/60 s; hydro_k() gives the share per step, so
// substeps don't stiffen the grid. Mirror: SimParams.HYDRO_K.
const float HYDRO_K = 0.5;

float hydro_k() {
	return 1.0 - pow(1.0 - HYDRO_K, params.dt * 60.0);
}
// Density over rest from which the cell above counts as full (see hydro_sweep).
// Mirror: SimParams.HYDRO_FULL.
const float HYDRO_FULL = 0.95;
// Powder density over rest above which a thin cell isn't pulled full (see hydro_sweep).
// Mirror: SimParams.HYDRO_POWDER.
const float HYDRO_POWDER = 0.05;

ivec2 hydro_size() {
	return ivec2((int(params.grid_w) + HYDRO_CELL - 1) / HYDRO_CELL,
			(int(params.grid_h) + HYDRO_CELL - 1) / HYDRO_CELL);
}

float hydro_cell_size() { return params.h * float(HYDRO_CELL); }

uint hydro_index(ivec2 c) { return uint(c.y * hydro_size().x + c.x); }

// Share of a 1D tent of half-width a, centred at c, that lies inside [0, w].
float hydro_tent_inside(float c, float a, float w) {
	float lo = max(1.0 - c / a, 0.0);
	float hi = max(1.0 - (w - c) / a, 0.0);
	return 1.0 - 0.5 * (lo * lo + hi * hi);
}

// Adds a particle at x to the density sums (channel 0 liquid, 1 powder): its tent
// weight (bilinear, half-width one cell) on the four nearest cell centres, in fixed
// point so it can use atomicAdd.
// Integer sums don't depend on the order of the adds, so the result is deterministic.
// (A gather per cell over the hash took ~900 us at 50k: 920 threads, each looping
// over ~300 particles.)
void hydro_splat(vec2 x, uint channel) {
	ivec2 size = hydro_size();
	vec2 g = x / hydro_cell_size() - 0.5;
	ivec2 b = ivec2(floor(g));
	vec2 f = g - vec2(b);
	for (int dy = 0; dy < 2; dy++) {
		for (int dx = 0; dx < 2; dx++) {
			ivec2 c = b + ivec2(dx, dy);
			if (c.x < 0 || c.y < 0 || c.x >= size.x || c.y >= size.y) {
				continue;
			}
			float w = (dx == 0 ? 1.0 - f.x : f.x) * (dy == 0 ? 1.0 - f.y : f.y);
			atomicAdd(hydro_acc[2u * hydro_index(c) + channel], int(round(w * HYDRO_FP)));
		}
	}
}

// Liquid and powder density over rest at coarse cell c from the splatted sums: the tent
// weight over the weight at rest spacing of the part of the tent inside the world (at
// the walls only part of it can be filled).
vec2 hydro_density(ivec2 ci) {
	float a = hydro_cell_size();
	vec2 centre = (vec2(ci) + 0.5) * a;
	uint i = hydro_index(ci);
	vec2 sum = vec2(float(hydro_acc[2u * i]), float(hydro_acc[2u * i + 1u])) / HYDRO_FP;
	float inside = hydro_tent_inside(centre.x, a, params.world_size.x)
			* hydro_tent_inside(centre.y, a, params.world_size.y);
	return sum * params.spacing * params.spacing / (a * a * inside);
}

// One projected red-black SOR sweep over the cells of one parity ((x + y) % 2), in
// place. Per cell, with a the cell size: sum over in-grid neighbours of (p_n - p) =
// -a^2 HYDRO_K err / dt^2. Out-of-grid neighbours are walls and drop out. Air
// neighbours have p = 0. Each sweep is its own dispatch: one workgroup doing all the
// sweeps in shared memory was 3x slower (latency-bound on one compute unit).
void hydro_sweep(uint parity) {
	ivec2 size = hydro_size();
	uint c = gl_GlobalInvocationID.x;
	if (c >= uint(size.x * size.y)) {
		return;
	}
	ivec2 ci = ivec2(int(c) % size.x, int(c) / size.x);
	if (uint(ci.x + ci.y) % 2u != parity) {
		return;
	}
	float phi = hydro_phi[c].x;
	if (phi < HYDRO_AIR) {
		hydro_p[c] = 0.0;
		return;
	}
	float sum = 0.0;
	float n = 0.0;
	for (int k = 0; k < 4; k++) {
		ivec2 off = k == 0 ? ivec2(1, 0) : (k == 1 ? ivec2(-1, 0) : (k == 2 ? ivec2(0, 1) : ivec2(0, -1)));
		ivec2 nc = ci + off;
		if (nc.x < 0 || nc.y < 0 || nc.x >= size.x || nc.y >= size.y) {
			continue;
		}
		uint ni = hydro_index(nc);
		float phi_n = hydro_phi[ni].x;
		n += 1.0;
		sum += phi_n < HYDRO_AIR ? 0.0 : hydro_p[ni];
	}
	// Compression is always corrected. A thin cell is pulled full only under full water
	// (the cell above it at least HYDRO_FULL) and with almost no powder in it: an air
	// bubble trapped in the water closes from the top, while cells at the free surface,
	// which are rightly part-filled, aren't pulled together. Requiring all four
	// neighbours full left 30k water full of bubbles next to each other; counting cells
	// part-filled with sand as bubbles pulled water into a sand bed forever, and water
	// over sand churned at 9 px/s (GPU probe).
	bool covered = ci.y > 0 && hydro_phi[hydro_index(ci - ivec2(0, 1))].x >= HYDRO_FULL
			&& hydro_phi[c].y < HYDRO_POWDER;
	float err = covered ? phi - 1.0 : max(phi - 1.0, 0.0);
	float a = hydro_cell_size();
	float rhs = -a * a * hydro_k() * err / (params.dt * params.dt);
	hydro_p[c] = max(mix(hydro_p[c], (sum - rhs) / n, HYDRO_SOR), 0.0);
}

// Pressure at coarse cell c. Past the grid edge it is mirrored, so walls let nothing through.
float hydro_p_at(ivec2 c) {
	uint i = hydro_index(clamp(c, ivec2(0), hydro_size() - ivec2(1)));
	return hydro_phi[i].x < HYDRO_AIR ? 0.0 : hydro_p[i];
}

// Bilinear pressure at position x (cell centres at (i + 0.5) * cell size).
float hydro_p_sample(vec2 x) {
	vec2 g = x / hydro_cell_size() - 0.5;
	ivec2 b = ivec2(floor(g));
	vec2 f = g - vec2(b);
	float p00 = hydro_p_at(b);
	float p10 = hydro_p_at(b + ivec2(1, 0));
	float p01 = hydro_p_at(b + ivec2(0, 1));
	float p11 = hydro_p_at(b + ivec2(1, 1));
	return mix(mix(p00, p10, f.x), mix(p01, p11, f.x), f.y);
}

// Position change this step from the pressure: -grad p * dt^2 (central difference over
// half a coarse cell).
vec2 hydro_delta(vec2 x) {
	float e = 0.5 * hydro_cell_size();
	vec2 grad = vec2(hydro_p_sample(x + vec2(e, 0.0)) - hydro_p_sample(x - vec2(e, 0.0)),
			hydro_p_sample(x + vec2(0.0, e)) - hydro_p_sample(x - vec2(0.0, e))) / (2.0 * e);
	return -grad * params.dt * params.dt;
}
